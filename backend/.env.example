# Backend environment template — variable NAMES only, never real values.
# Copy this file to backend/.env and fill in the values.
# backend/.env is gitignored — never commit real credentials.

# Required. URL format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
# (no trailing slash)
DATABASE_URL=

# Required. LLM provider API key — the backend refuses to start without it.
LLM_API_KEY=

# Optional — defaults shown in the code (backend/llm.py, backend/search_provider.py).
LLM_BASE_URL=
LLM_MODEL=
SEARCH_PROVIDER=
ANALYSIS_BUDGET_USD=
LLM_PRICING_JSON=
